dev tun
persist-tun
persist-key
cipher AES-256-CBC
ncp-ciphers AES-128-GCM:AES-256-GCM
auth SHA512
tls-client
client
resolv-retry infinite
remote 206.42.46.55 1194 udp
setenv opt block-outside-dns
lport 0
auth-user-pass
ca firewall-UDP4-1194-ca.crt
tls-auth firewall-UDP4-1194-tls.key 1
remote-cert-tls server
passtos

